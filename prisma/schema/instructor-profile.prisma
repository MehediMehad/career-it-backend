model InstructorProfile {
  id String @id @default(uuid())

  // Instructor specific fields
  bio                  String
  headline             String
  expertiseArea        String[]
  yearsOfExperience    Int
  Education            String
  linkedinProfile      String?
  portfolioWebsiteLink String?
  
  adminApproved AdminApprovalStatus @default(PENDING)

  totalEarnings Decimal @default(0.00) @db.Decimal(10, 2)
  rating        Float   @default(0.0)
  totalReviews  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String @unique // 1:1 relation with User

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
  @@map("instructor_profiles")
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
