model User {
  id       String         @id @default(uuid())
  customId String         @unique // ex: "STUDENT-0001" Or "INSTRUCTOR-0001" Or "ADMIN-0001"
  name     String
  image    String?
  email    String         @unique
  password String
  role     UserRoleEnum   @default(STUDENT)
  status   UserStatusEnum @default(DEACTIVATE)

  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  devices            Device[]
  fileUploads        FileUpload[]
  instructorProfile  InstructorProfile?
  studentProfile     StudentProfile?
  courseCertificates CourseCertificate[]

  @@index([name])
  @@map("users")
}

enum UserRoleEnum {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatusEnum {
  DEACTIVATE
  ACTIVE
  BLOCKED
}
