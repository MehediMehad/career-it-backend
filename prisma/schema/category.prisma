model Category {
  id          String   @id @default(uuid())
  title       String   @unique
  slug        String   @unique
  image       String?
  courseCount Int      @default(0)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  courses Course[]

  @@map("categories")
}
